# Database Configuration (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/talknt_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="talknt_super_secret_jwt_key_2026"

# Server Configuration
PORT=5000

# DeepSeek API Configuration
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# WhatsApp Agent & TTS Configuration
BOT_NAME="Talkn't Agent"
USER_NAME="Candra"
AUTO_REPLY_MODE=true
AUTO_REPLY_PREFIX="🤖 [AI] "
TTS_VOICE="id-ID-ArdiNeural"

# Storage & Media Paths
MEDIA_STORAGE_DIR="./media_assets"
PRESENTATION_STORAGE_DIR="./storage/presentations"
AUDIO_STORAGE_DIR="./storage/audio"
SESSION_DIR="./sessions"
LOG_LEVEL="info"
