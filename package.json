{
  "name": "talknt",
  "version": "2.1.0",
  "description": "Full-Stack AI Agent WhatsApp & Public Speaking Co-Pilot dengan PostgreSQL & Prisma ORM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm --prefix client run build",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "ai-agent",
    "deepseek",
    "postgresql",
    "prisma",
    "fullstack"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "officeparser": "^5.1.1",
    "openai": "^4.56.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.12",
    "prisma": "^5.16.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
