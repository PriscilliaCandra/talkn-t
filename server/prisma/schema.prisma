// Prisma Schema for Talkn't SaaS Application (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  waSessions      WaSession[]
  aiSettings      AiSetting?
  presentations   Presentation[]
  messages        Message[]
  presenterVideos VirtualPresenterVideo[]
}

model WaSession {
  id          String   @id @default(uuid())
  userId      String   @unique
  sessionData String?  @db.Text
  isConnected Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiSetting {
  id               String   @id @default(uuid())
  userId           String   @unique
  systemPrompt     String   @db.Text
  autoReplyEnabled Boolean  @default(true)
  languageStyle    String   @default("introvert_casual")
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Presentation {
  id        String   @id @default(uuid())
  userId    String
  title     String
  filePath  String
  audioPath String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id           String   @id @default(uuid())
  userId       String?
  jid          String
  senderNumber String
  senderName   String?
  body         String   @db.Text
  isFromMe     Boolean  @default(false)
  isAi         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jid])
  @@index([createdAt])
}

model VirtualPresenterVideo {
  id              String   @id @default(uuid())
  userId          String?
  title           String
  pptFileName     String
  facePhotoPath   String?
  voiceSamplePath String?
  scriptText      String?  @db.Text
  videoUrl        String?
  status          String   @default("uploading")
  statusMessage   String?  @default("Menyiapkan berkas...")
  progress        Int      @default(0)
  language        String   @default("id-ID")
  layoutPreset    String   @default("side_by_side")
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
